# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Real secrets live only there.
# Lines starting with # are optional/illustrative.

# ============================================================================
# VTU providers  -  pattern: VTU_<PROVIDER>_<SETTING>
# A provider is used only if it is ENABLED here, fully configured, switched on in Django admin
# (VTU Provider states) and not suspended by the circuit breaker.
# Validate with:   python manage.py check      python manage.py vtu_providers [--test]
# ============================================================================

# --- Nellobytes / ClubKonnect (implemented; vtu_app/gateway/adapters/nellobytes.py) ---
# Defaults to ENABLED so the existing deployment keeps working; set to false to turn it off.
VTU_NELLOBYTES_ENABLED=true
VTU_NELLOBYTES_USER_ID=your_nellobytes_user_id
VTU_NELLOBYTES_API_KEY=your_nellobytes_api_key
# Optional:
# VTU_NELLOBYTES_BASE_URL=https://www.nellobytesystems.com
# VTU_NELLOBYTES_TIMEOUT=30
# Lower number = tried first (admin override in Django admin wins over this). Default 10.
# VTU_NELLOBYTES_PRIORITY=10
# The names this app used before the gateway are still honoured when the VTU_NELLOBYTES_* ones are empty:
#   NELLOBYTE_USER_ID / NELLOBYTE_API_KEY / NELLOBYTE_BASE_URL   (and CK_USER_ID / CK_API_KEY)

# --- Gongoz Concept (implemented, conservative: see docs/VTU_PROVIDERS.md "Gongoz") ---
# Token from https://www.gongozconcept.com/documentation/ . Off by default.
VTU_GONGOZ_ENABLED=false
# VTU_GONGOZ_API_KEY=your_gongoz_token
# VTU_GONGOZ_BASE_URL=https://www.gongozconcept.com/api
# VTU_GONGOZ_PRIORITY=20          # use 1 (and VTU_NELLOBYTES_PRIORITY=50) to make Gongoz primary
# Gongoz does not document its order-status words. Make ONE small real purchase, read the Status value of that
# order (GET /api/<data|topup|billpayment|cablesub>/<id>), then list the words here (comma separated). Until set,
# Gongoz orders stay Pending and are never auto-completed or auto-refunded.
# VTU_GONGOZ_SUCCESS_STATUSES=
# VTU_GONGOZ_FAILED_STATUSES=

# --- Routing / resilience (all optional) ---
# Consecutive health-affecting failures before a provider is suspended (default 5)
# VTU_FAILURE_THRESHOLD=5
# Minutes a suspended provider is skipped before being tried again (default 10)
# VTU_SUSPEND_MINUTES=10
# Dotted path of the routing policy class (default: priority order)
# VTU_ROUTING_POLICY=vtu_app.gateway.router.PriorityPolicy

# Public base URL providers use for order callbacks (/api/v1/vtu/webhook/<provider>/). Empty = send no callback URL.
PUBLIC_BASE_URL=https://www.btdataplug.com

# ============================================================================
# Rest of the platform (unchanged)
# ============================================================================
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=btdataplug.pythonanywhere.com,www.btdataplug.com
# MONNIFY_API_KEY=
# MONNIFY_SECRET_KEY=
# MONNIFY_CONTRACT_CODE=
# MONNIFY_BASE_URL=
# MY_PERSONAL_BVN=
# MY_PERSONAL_NIN=
# PAYSTACK_SECRET_KEY=
# EMAIL_HOST= / EMAIL_PORT= / EMAIL_HOST_USER= / EMAIL_HOST_PASSWORD= / EMAIL_USE_TLS= / DEFAULT_FROM_EMAIL=
# CORS_ALLOWED_ORIGINS=
# DEVELOPER_API_ASYNC_WEBHOOKS=True
